{
  "name": "kgp-bazaar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/check-design-tokens.mjs",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "qa:bootstrap": "node scripts/qa-bootstrap.mjs",
    "qa:teardown": "node scripts/qa-bootstrap.mjs --teardown",
    "qa:status": "node scripts/qa-bootstrap.mjs --status",
    "test:qa": "npm run test && npm run test:e2e",
    "qa:verify": "npm run lint && npm run typecheck && npm run test:qa && npm run build",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "check:tokens": "node scripts/check-design-tokens.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@supabase/supabase-js": "^2.39.8",
    "@tanstack/react-query": "^5.28.9",
    "@types/mixpanel-browser": "^2.60.0",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.2",
    "clsx": "^2.1.1",
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.344.0",
    "mixpanel-browser": "^2.81.0",
    "piexifjs": "^1.0.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.2",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "axe-core": "^4.13.0",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.0.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "supabase": "^2.113.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.3",
    "typescript-eslint": "^7.3.1",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
